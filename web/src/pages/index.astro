---
const codeExample = `package main

import (
    "fmt"
    "github.com/Shobhit-Nagpal/pgn"
)

func main() {
    // Parse a PGN string
    gameStr := \`[Event "F/S Return Match"]
[Site "Belgrade, Serbia JUG"]
[Date "1992.11.04"]
[Round "29"]
[White "Fischer, Robert J."]
[Black "Spassky, Boris V."]
[Result "1/2-1/2"]

1. e4 e5 2. Nf3 Nc6 3. Bb5 1/2-1/2\`
    
    game, err := pgn.New(gameStr)
    if err != nil {
        panic(err)
    }
    
    // Access game information
    fmt.Println("Event:", game.Event())
    fmt.Println("White Player:", game.White())
    fmt.Println("Black Player:", game.Black())
    fmt.Println("Result:", game.Result())
}`;

const installCommand = "go get github.com/Shobhit-Nagpal/pgn";

const copyToClipboard = `
function copyInstallCommand() {
    navigator.clipboard.writeText('${installCommand}').then(() => {
        const button = document.querySelector('.copy-button');
        const originalText = button.innerHTML;
        button.innerHTML = '✓ Copied!';
        button.classList.add('copied');
        setTimeout(() => {
            button.innerHTML = originalText;
            button.classList.remove('copied');
        }, 2000);
    });
}
`;

const methods = [
    {
        signature: "New(pgn string) (*Game, error)",
        description: "Create a new game from PGN string"
    },
    {
        signature: "GetTag(name string) string",
        description: "Get the value of a specific tag"
    },
    {
        signature: "SetTag(tag, value string)",
        description: "Set a tag"
    },
    {
        signature: "Event() string",
        description: "Get the event name"
    },
    {
        signature: "Site() string",
        description: "Get the site/location"
    },
    {
        signature: "White() string",
        description: "Get the white player's name"
    },
    {
        signature: "Black() string",
        description: "Get the black player's name"
    },
    {
        signature: "Result() string",
        description: "Get the game result"
    },
    {
        signature: "Winner() string",
        description: "Get the winner (\"White\", \"Black\", \"Draw\", or \"Unknown\")"
    },
    {
        signature: "IsDraw() bool",
        description: "Check if the game ended in a draw"
    },
    {
        signature: "Moves() map[int]*Move",
        description: "Get all moves"
    },
    {
        signature: "GetMove(number int) *Move",
        description: "Get a specific move by number"
    }
];

const features = [
    "Parse PGN format chess games",
    "Access standard PGN tags (Event, Site, Date, Round, White, Black, Result)",
    "Custom tag support",
    "Move tracking with commentary support",
    "Game result handling",
    "Zero dependencies"
];
